# Copy to .env (never commit .env). All optional for local development.
PORT=4000
# Required in production; any long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
# SQLite file; tests use :memory:
# DB_PATH=./data/shelter.db
# Restrict CORS to the client's URL when deployed
# CLIENT_ORIGIN=http://localhost:5173
